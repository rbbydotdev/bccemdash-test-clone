---
/**
 * Closing CTA — full-bleed image with a night veil and a single bold devotion
 * CTA. Copy/image from BccSettings.
 */
import { getBccSettings } from "@bcc/plugin/server";
import { mediaUrl } from "../../lib/content";

const s = await getBccSettings();
const img = await mediaUrl(s.closing.image);
const devoteUrl = s.integrations.devoteUrl;
---

<section id="closing" class="relative overflow-hidden py-[var(--spacing-section-md)] lg:py-[calc(var(--spacing-section-lg)*1.3)]">
	{img && <img src={img} alt="" class="absolute inset-0 h-full w-full object-cover object-center" />}
	<div class="absolute inset-0 bg-night/80"></div>
	<div
		class="absolute inset-0"
		style="box-shadow: var(--shadow-hero-overlay);"
	>
	</div>

	<div class="relative z-10 mx-auto max-w-3xl px-[var(--spacing-gutter)] text-center">
		<h2 data-animate class="font-display text-[clamp(2.5rem,5vw,4rem)] leading-tight text-moon">
			{s.closing.line1} <span class="italic text-gradient-amber">{s.closing.line1Accent}</span>
		</h2>
		<h3 data-animate data-animate-delay="100" class="mt-3 font-display text-2xl text-moon">
			{s.closing.line2}
		</h3>
		<p data-animate data-animate-delay="200" class="mt-4 text-silver/80">{s.closing.line3}</p>
		<a
			href={devoteUrl}
			data-animate
			data-animate-delay="300"
			class="mt-10 inline-block rounded-sm bg-amber px-12 py-5 font-accent text-sm font-bold uppercase tracking-[var(--tracking-eyebrow)] text-night transition hover:-translate-y-0.5 hover:bg-amber-light hover:shadow-[var(--shadow-amber-glow-strong)]"
		>
			{s.closing.cta}
		</a>
	</div>
</section>
