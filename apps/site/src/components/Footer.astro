---
/**
 * Site footer — a photo-caption strip over the footer image, then brand +
 * navigate + connect columns, then the legal line. All copy/imagery from the
 * editable BccSettings.
 */
import { getBccSettings } from "@myemdash/plugin/server";
import { getMenu } from "emdash";
import { mediaUrl } from "../lib/content";

const s = await getBccSettings();
const footerImg = await mediaUrl(s.footer.image);

type NavLink = { label: string; url: string; target?: string };

const FALLBACK_NAV_LINKS: NavLink[] = [
	{ label: "Story", url: "/#story" },
	{ label: "Devotions", url: "/#devotions" },
	{ label: "Experiences", url: "/#experiences" },
	{ label: "Programs", url: "/programs" },
	{ label: "Contact", url: "/#contact" },
];

const footerMenu = await getMenu("footer");
const navLinks: NavLink[] = footerMenu?.items.length ? footerMenu.items : FALLBACK_NAV_LINKS;

// Brand marks from Phosphor Icons (MIT), regular weight — hence the 256 viewBox.
const SOCIAL_ICONS = {
	instagram:
		"M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160ZM176,24H80A56.06,56.06,0,0,0,24,80v96a56.06,56.06,0,0,0,56,56h96a56.06,56.06,0,0,0,56-56V80A56.06,56.06,0,0,0,176,24Zm40,152a40,40,0,0,1-40,40H80a40,40,0,0,1-40-40V80A40,40,0,0,1,80,40h96a40,40,0,0,1,40,40ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z",
	x: "M214.75,211.71l-62.6-98.38,61.77-67.95a8,8,0,0,0-11.84-10.76L143.24,99.34,102.75,35.71A8,8,0,0,0,96,32H48a8,8,0,0,0-6.75,12.3l62.6,98.37-61.77,68a8,8,0,1,0,11.84,10.76l58.84-64.72,40.49,63.63A8,8,0,0,0,160,224h48a8,8,0,0,0,6.75-12.29ZM164.39,208,62.57,48h29L193.43,208Z",
	facebook:
		"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm8,191.63V152h24a8,8,0,0,0,0-16H136V112a16,16,0,0,1,16-16h16a8,8,0,0,0,0-16H152a32,32,0,0,0-32,32v24H96a8,8,0,0,0,0,16h24v63.63a88,88,0,1,1,16,0Z",
};

const socials = [
	{ key: "instagram", label: "Instagram", url: s.social.instagram, icon: SOCIAL_ICONS.instagram },
	{ key: "twitter", label: "X", url: s.social.twitter, icon: SOCIAL_ICONS.x },
	{ key: "facebook", label: "Facebook", url: s.social.facebook, icon: SOCIAL_ICONS.facebook },
].filter((x) => x.url);

const BAT =
	"M50 30 C45 15, 20 5, 2 20 C15 18, 25 22, 35 28 C38 20, 44 16, 50 14 C56 16, 62 20, 65 28 C75 22, 85 18, 98 20 C80 5, 55 15, 50 30Z";
---

<footer id="footer" class="relative bg-deep">
	{footerImg && (
		<div class="relative flex h-64 items-center justify-center overflow-hidden md:h-80">
			<img src={footerImg} alt="" class="absolute inset-0 h-full w-full object-cover object-center" />
			<div class="absolute inset-0 bg-night/70"></div>
			<p
				data-animate
				class="relative z-10 px-6 text-center font-display text-3xl italic text-moon md:text-4xl"
			>
				{s.footer.caption}
			</p>
		</div>
	)}

	<div class="border-t border-white/5">
		<div class="mx-auto grid max-w-[var(--width-shell)] gap-12 px-[var(--spacing-gutter)] py-20 md:grid-cols-3">
			<div>
				<a href="/" class="flex items-center gap-3" aria-label="Bat City Council home">
					<svg viewBox="0 0 100 60" class="h-7 w-8 text-amber" aria-hidden="true">
						<path d={BAT} fill="currentColor" />
					</svg>
					<span class="font-display text-xl text-moon">Bat City Council</span>
				</a>
				<p class="mt-4 font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">
					{s.footer.tagline}
				</p>
				<p class="mt-4 max-w-xs text-sm text-silver/70">
					Austin is a global example of how to live harmoniously with bats.
				</p>
			</div>

			<div>
				<p class="font-accent text-xs uppercase tracking-[var(--tracking-eyebrow)] text-amber">{s.footer.navHeading}</p>
				<ul class="mt-4 flex flex-col gap-3">
					{navLinks.map((l) => (
						<li>
							<a
								href={l.url}
								target={l.target || undefined}
								rel={l.target === "_blank" ? "noopener noreferrer" : undefined}
								class="font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver transition-colors hover:text-amber"
							>
								{l.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p class="font-accent text-xs uppercase tracking-[var(--tracking-eyebrow)] text-amber">{s.footer.connectHeading}</p>
				<a
					href={`mailto:${s.footer.contactEmail}`}
					class="mt-4 block text-sm text-moon/80 transition-colors hover:text-amber"
				>
					{s.footer.contactEmail}
				</a>
				<a
					href={s.footer.foundBatUrl}
					class="mt-2 block text-sm text-moon/80 transition-colors hover:text-amber"
				>
					{s.footer.foundBatLabel}
				</a>
				{socials.length > 0 && (
					<div class="mt-5 flex gap-3">
						{socials.map((soc) => (
							<a
								href={soc.url}
								aria-label={soc.label}
								class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-silver transition-colors hover:border-amber hover:text-amber"
							>
								<svg viewBox="0 0 256 256" class="h-5 w-5" fill="currentColor" aria-hidden="true">
									<path d={soc.icon} />
								</svg>
							</a>
						))}
					</div>
				)}
			</div>
		</div>

		<div class="border-t border-white/5">
			<div class="mx-auto max-w-[var(--width-shell)] px-[var(--spacing-gutter)] py-8">
				<p class="text-center text-xs text-silver/60" set:html={s.footer.copyright} />
			</div>
		</div>
	</div>
</footer>
