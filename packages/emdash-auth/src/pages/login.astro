---
/**
 * /login — email + password. On a fresh install (no admin yet) this is the
 * first-admin bootstrap (create the admin with email+password, no passkey
 * needed); otherwise it is the sign-in form. Passkey login always remains
 * available at /_emdash/admin.
 *
 * Self-contained: no host layout dependency. Styled from the integration's
 * resolved config (site name + accent). Override by shipping your own page at
 * the same path if you want it to match your theme.
 */
import { needsBootstrap } from "emdash-auth/server";
import { config } from "virtual:emdash-auth/config";

// If already signed in, go straight to the admin.
const current = Astro.locals.user as { id?: string } | undefined;
if (current?.id) {
	return Astro.redirect(config.loginRedirect);
}

const bootstrap = await needsBootstrap();
const error = Astro.url.searchParams.get("error");
const action = bootstrap ? config.bootstrapApiPath : config.loginApiPath;
const heading = bootstrap ? "Create admin account" : "Sign in";
const accent = config.accent;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{heading} · {config.siteName}</title>
		<style define:vars={{ accent }}>
			:root { color-scheme: dark; }
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1rem;
				font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				background: #0b0d12;
				color: #e7e9ee;
			}
			.card {
				width: 100%;
				max-width: 26rem;
			}
			.brand { text-align: center; margin-bottom: 1.75rem; }
			.brand a { color: #f4f5f8; font-size: 1.4rem; font-weight: 600; text-decoration: none; }
			.eyebrow {
				margin-top: 0.5rem;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--accent);
			}
			.hint { margin-top: 0.75rem; font-size: 0.85rem; color: #9aa1ad; }
			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				padding: 2rem;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 0.75rem;
				background: rgba(255, 255, 255, 0.02);
			}
			label { display: block; }
			label span {
				display: block;
				margin-bottom: 0.4rem;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #9aa1ad;
			}
			input {
				width: 100%;
				padding: 0.75rem 0.9rem;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 0.4rem;
				background: rgba(0, 0, 0, 0.35);
				color: #f4f5f8;
				font-size: 0.95rem;
				outline: none;
				transition: border-color 0.15s;
			}
			input:focus { border-color: var(--accent); }
			.meta { margin-top: 0.4rem; font-size: 0.72rem; color: #7c828d; }
			button {
				margin-top: 0.25rem;
				padding: 0.85rem 1rem;
				border: 0;
				border-radius: 0.4rem;
				background: var(--accent);
				color: #fff;
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.03em;
				cursor: pointer;
				transition: filter 0.15s;
			}
			button:hover { filter: brightness(1.1); }
			.error {
				padding: 0.75rem 1rem;
				border: 1px solid rgba(248, 113, 113, 0.3);
				border-radius: 0.4rem;
				background: rgba(248, 113, 113, 0.1);
				color: #fca5a5;
				font-size: 0.85rem;
			}
			.footnote { margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: #9aa1ad; }
			.footnote a { color: var(--accent); text-decoration: none; }
		</style>
	</head>
	<body>
		<main class="card">
			<div class="brand">
				<a href="/">{config.siteName}</a>
				<p class="eyebrow">{heading}</p>
				{bootstrap && <p class="hint">No admin exists yet. Create the first one to manage the site.</p>}
			</div>

			<form method="POST" action={action}>
				{error && <p class="error">{error}</p>}

				{bootstrap && (
					<label>
						<span>Name</span>
						<input type="text" name="name" autocomplete="name" />
					</label>
				)}

				<label>
					<span>Email</span>
					<input type="email" name="email" required autocomplete="username" />
				</label>

				<label>
					<span>Password</span>
					<input
						type="password"
						name="password"
						required
						minlength={bootstrap ? "10" : undefined}
						autocomplete={bootstrap ? "new-password" : "current-password"}
					/>
					{bootstrap && <span class="meta">At least 10 characters.</span>}
				</label>

				<button type="submit">{bootstrap ? "Create admin & continue" : "Sign in"}</button>
			</form>

			{!bootstrap && (
				<p class="footnote">
					Registered a passkey? <a href={config.loginRedirect}>Sign in with a passkey</a>
				</p>
			)}
		</main>
	</body>
</html>
