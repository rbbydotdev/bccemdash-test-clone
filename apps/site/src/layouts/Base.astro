---
/**
 * Base layout — the public-site shell.
 *
 * Head (SEO via EmDashHead, Astro-managed webfonts), skip link, header +
 * footer (overridable via named slots), film-grain overlay, and the
 * [data-animate] scroll-reveal observer (respects prefers-reduced-motion).
 */
import { getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { getBccSettings } from "@myemdash/plugin/server";
import { mediaUrl } from "../lib/content";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	/** Content reference for plugin page contributions on content pages. */
	content?: { collection: string; id: string; slug?: string | null };
	/** Homepage mode: header floats transparent over the hero. */
	transparentHeader?: boolean;
	/** Hide the shared header/footer (e.g. a fully bespoke landing page). */
	bare?: boolean;
}

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	content,
	transparentHeader = false,
	bare = false,
} = Astro.props;

const settings = await getSiteSettings().catch(() => null);
const siteTitle = settings?.title ?? "Bat City Council";
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Design tokens (the WP Customizer equivalent): emit :root --bcc-* custom
// properties from the editable design settings. The @myemdash/theme @theme tokens
// read these hooks (var(--bcc-amber, fallback)), so edits retint the site.
const bcc = await getBccSettings();
const c = bcc.design.colors;
const f = bcc.design.fonts;
const rootVars = [
	`--bcc-night:${c.night}`,
	`--bcc-deep:${c.deep}`,
	`--bcc-amber:${c.amber}`,
	`--bcc-amber-light:${c.amberLight}`,
	`--bcc-moon:${c.moon}`,
	`--bcc-silver:${c.silver}`,
	`--bcc-font-display:'${f.display}',ui-serif,Georgia,serif`,
	`--bcc-font-body:'${f.body}',ui-serif,Georgia,serif`,
	`--bcc-font-accent:'${f.accent}',ui-sans-serif,system-ui,sans-serif`,
].join(";");

// Favicon: an emdash media id resolved to a servable URL. Blank = none emitted.
const faviconUrl = await mediaUrl(bcc.design.favicon);

// Social card: pages without their own image fall back to the generated hero
// card at /og/site.png. The ?v= tag is a short digest of the hero content, so
// the URL changes when the client edits the hero and scrapers re-fetch instead
// of serving a stale thumbnail.
const h = bcc.hero;
const ogVersion = [h.eyebrow, h.titleLine1, h.titleLine2, h.subhead, h.image, c.amber, c.night]
	.join("|")
	.split("")
	.reduce((acc, ch) => ((acc * 31 + ch.charCodeAt(0)) | 0), 7)
	.toString(36)
	.replace("-", "z");
// The card is rendered by a separate Worker (apps/og) so the 3.6 MB Takumi
// WASM never ships in this bundle. Base URL is editable in Site Content so it
// can be swapped without a redeploy; blank falls back to same-origin /og.
const ogBase = (bcc.integrations.ogWorkerUrl || "").trim().replace(/\/$/, "");
const ogPath = `/site.png?v=${ogVersion}`;
const ogImage =
	image ?? (ogBase ? `${ogBase}${ogPath}` : new URL(`/og${ogPath}`, Astro.url).href);

// Analytics tags (public pages only — the admin never renders this layout).
// The GA id is validated to GA's own format so a stray paste can't inject markup;
// headSnippet is intentionally raw for other vendors' tags.
const gaId = /^G-[A-Z0-9]+$/i.test(bcc.analytics.googleAnalyticsId.trim())
	? bcc.analytics.googleAnalyticsId.trim()
	: "";
const headSnippet = bcc.analytics.headSnippet.trim();

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title,
	description,
	canonical,
	image: ogImage,
	content,
	seo: { ogImage, robots },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-display-webfont" preload />
		<Font cssVariable="--font-body-webfont" preload />
		<Font cssVariable="--font-accent-webfont" preload />
		<title>{fullTitle}</title>
		{faviconUrl && <link rel="icon" href={faviconUrl} />}
		<style set:html={`:root{${rootVars}}`}></style>
		<EmDashHead page={pageCtx} />
		{gaId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script
					is:inline
					set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
				/>
			</>
		)}
		{headSnippet && <Fragment set:html={headSnippet} />}
	</head>
	<body class="bcc-grain">
		<EmDashBodyStart page={pageCtx} />

		<a
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[999] focus:rounded-md focus:bg-amber focus:px-4 focus:py-2 focus:text-night"
			href="#main"
		>
			Skip to content
		</a>

		{!bare && (
			<slot name="header">
				<Header transparent={transparentHeader} />
			</slot>
		)}

		<main id="main">
			<slot />
		</main>

		{!bare && (
			<slot name="footer">
				<Footer />
			</slot>
		)}

		<script>
			import "../scripts/site.ts";
		</script>

		<noscript>
			<style>
				[data-animate] { opacity: 1; transform: none; }
			</style>
		</noscript>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
