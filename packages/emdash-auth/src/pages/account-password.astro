---
/**
 * /account/password — set (or change) your email+password sign-in. Requires an
 * authenticated session; sign in with your passkey (or existing password)
 * first, then set/rotate a password here so you can sign in at the login page
 * with email + password.
 *
 * Self-contained (no host layout dependency); styled from the resolved config.
 */
import { config } from "virtual:emdash-auth/config";

const user = Astro.locals.user as { id?: string; email?: string; name?: string } | undefined;
if (!user?.id) {
	return Astro.redirect(config.loginRedirect);
}

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");
const accent = config.accent;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Set a password · {config.siteName}</title>
		<style define:vars={{ accent }}>
			:root { color-scheme: dark; }
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1rem;
				font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				background: #0b0d12;
				color: #e7e9ee;
			}
			.card { width: 100%; max-width: 26rem; }
			.brand { text-align: center; margin-bottom: 1.75rem; }
			.brand a { color: #f4f5f8; font-size: 1.4rem; font-weight: 600; text-decoration: none; }
			.eyebrow {
				margin-top: 0.5rem;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--accent);
			}
			.who { margin-top: 0.5rem; font-size: 0.85rem; color: #9aa1ad; }
			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				padding: 2rem;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 0.75rem;
				background: rgba(255, 255, 255, 0.02);
			}
			label span {
				display: block;
				margin-bottom: 0.4rem;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #9aa1ad;
			}
			input {
				width: 100%;
				padding: 0.75rem 0.9rem;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 0.4rem;
				background: rgba(0, 0, 0, 0.35);
				color: #f4f5f8;
				font-size: 0.95rem;
				outline: none;
				transition: border-color 0.15s;
			}
			input:focus { border-color: var(--accent); }
			.meta { margin-top: 0.4rem; font-size: 0.72rem; color: #7c828d; display: block; }
			button {
				margin-top: 0.25rem;
				padding: 0.85rem 1rem;
				border: 0;
				border-radius: 0.4rem;
				background: var(--accent);
				color: #fff;
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				transition: filter 0.15s;
			}
			button:hover { filter: brightness(1.1); }
			.notice {
				padding: 0.75rem 1rem;
				border-radius: 0.4rem;
				font-size: 0.85rem;
				border: 1px solid rgba(255, 255, 255, 0.14);
			}
			.notice.ok { border-color: rgba(74, 222, 128, 0.3); background: rgba(74, 222, 128, 0.1); color: #86efac; }
			.notice.err { border-color: rgba(248, 113, 113, 0.3); background: rgba(248, 113, 113, 0.1); color: #fca5a5; }
			.footnote { margin-top: 1.5rem; text-align: center; font-size: 0.85rem; }
			.footnote a { color: var(--accent); text-decoration: none; }
		</style>
	</head>
	<body>
		<main class="card">
			<div class="brand">
				<a href="/">{config.siteName}</a>
				<p class="eyebrow">Set a password</p>
				{user.email && <p class="who">{user.email}</p>}
			</div>

			<form method="POST" action={config.setPasswordApiPath}>
				{ok && (
					<p class="notice ok">
						Password saved. You can now sign in at {config.loginPath} with your email and password.
					</p>
				)}
				{error && <p class="notice err">{error}</p>}

				<label>
					<span>New password</span>
					<input type="password" name="password" required minlength="10" autocomplete="new-password" />
					<span class="meta">At least 10 characters.</span>
				</label>

				<button type="submit">Save password</button>
			</form>

			<p class="footnote"><a href={config.loginRedirect}>Back to admin</a></p>
		</main>
	</body>
</html>
