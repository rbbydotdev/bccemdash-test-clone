---
/**
 * /blog — editorial list of the `posts` collection.
 */
import { getBccSettings } from "@myemdash/plugin/server";
import Base from "../../layouts/Base.astro";
import { publishedEntries, mediaUrl, str } from "../../lib/content";

const s = await getBccSettings();
const b = s.blog;
const posts = await publishedEntries("posts");
const cards = await Promise.all(posts.map(async (e) => ({ e, img: await mediaUrl(e.data.image) })));
---

<Base title={b.eyebrow} description={`${b.heading} ${b.headingAccent}`.trim()}>
	<section class="px-[var(--spacing-gutter)] pt-32 pb-[var(--spacing-section-lg)]">
		<div class="mx-auto max-w-3xl">
			<p class="text-center font-accent text-xs uppercase tracking-[var(--tracking-eyebrow)] text-amber">{b.eyebrow}</p>
			<h1 class="mt-6 text-center font-display text-[clamp(2.5rem,5vw,4rem)] leading-tight text-moon">
				{b.heading} <span class="italic text-gradient-amber">{b.headingAccent}</span>
			</h1>

			<div class="mt-16 flex flex-col divide-y divide-white/10">
				{cards.length === 0 && <p class="text-center text-silver/70">{b.empty}</p>}
				{cards.map(({ e, img }) => (
					<a href={`/blog/${e.slug}`} data-animate class="group flex items-center gap-6 py-8">
						{img && (
							<img src={img} alt={str(e.data, "title")} class="hidden h-24 w-32 shrink-0 rounded-[var(--radius-card)] object-cover sm:block" />
						)}
						<div>
							<h2 class="font-display text-2xl text-moon transition-colors group-hover:text-amber">
								{str(e.data, "title")}
							</h2>
							{str(e.data, "excerpt") && <p class="mt-2 text-sm text-moon/60">{str(e.data, "excerpt")}</p>}
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</Base>
