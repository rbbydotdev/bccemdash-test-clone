---
/**
 * /account/password — set (or change) your email+password sign-in. Requires an
 * authenticated session; sign in with your passkey first, then set a password
 * here so you can also sign in at /login with email + password.
 */
import Base from "../../layouts/Base.astro";

const user = Astro.locals.user as { id?: string; email?: string; name?: string } | undefined;
if (!user?.id) {
	return Astro.redirect("/_emdash/admin");
}

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");
---

<Base title="Set a Password" description="Set your password." robots="noindex" bare>
	<section class="flex min-h-screen items-center justify-center px-[var(--spacing-gutter)] py-24">
		<div class="w-full max-w-md">
			<div class="text-center">
				<a href="/" class="font-display text-2xl text-moon">Bat City Council</a>
				<p class="mt-2 font-accent text-xs uppercase tracking-[var(--tracking-eyebrow)] text-amber">
					Set a Password
				</p>
				{user.email && <p class="mt-2 text-sm text-silver/70">{user.email}</p>}
			</div>

			<form
				method="POST"
				action="/api/auth/set-password"
				class="mt-8 space-y-4 rounded-[var(--radius-card)] border border-white/10 bg-deep/50 p-8 backdrop-blur-[var(--blur-veil)]"
			>
				{ok && (
					<p class="rounded-sm border border-amber/30 bg-amber/10 px-4 py-3 text-sm text-amber-light">
						Password saved. You can now sign in at /login with your email and password.
					</p>
				)}
				{error && (
					<p class="rounded-sm border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
						{error}
					</p>
				)}

				<label class="block">
					<span class="font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">
						New password
					</span>
					<input
						type="password"
						name="password"
						required
						minlength="10"
						autocomplete="new-password"
						class="mt-2 w-full rounded-sm border border-white/15 bg-night/60 px-4 py-3 text-moon outline-none transition focus:border-amber"
					/>
					<span class="mt-2 block text-xs text-silver/60">At least 10 characters.</span>
				</label>

				<button
					type="submit"
					class="w-full rounded-sm bg-amber px-8 py-4 font-accent text-sm font-semibold uppercase tracking-[var(--tracking-label)] text-night transition hover:bg-amber-light"
				>
					Save Password
				</button>
			</form>

			<p class="mt-6 text-center text-sm text-silver/70">
				<a href="/_emdash/admin" class="text-amber transition hover:text-amber-light">Back to admin</a>
			</p>
		</div>
	</section>
</Base>
