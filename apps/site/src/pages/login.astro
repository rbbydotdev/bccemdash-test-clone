---
/**
 * /login — email + password. On a fresh install (no admin yet) this is the
 * first-admin bootstrap (create the admin with email+password, no passkey
 * needed); otherwise it is the sign-in form. Passkey login always remains
 * available at /_emdash/admin.
 */
import { needsBootstrap } from "emdash-auth/server";
import Base from "../layouts/Base.astro";

// If already signed in, go straight to the admin.
const current = Astro.locals.user as { id?: string } | undefined;
if (current?.id) {
	return Astro.redirect("/_emdash/admin");
}

const bootstrap = await needsBootstrap();
const error = Astro.url.searchParams.get("error");
const action = bootstrap ? "/api/auth/bootstrap" : "/api/auth/login";
const heading = bootstrap ? "Create Admin Account" : "Sign In";
---

<Base title={heading} description="Sign in to Bat City Council." robots="noindex" bare>
	<section class="flex min-h-screen items-center justify-center px-[var(--spacing-gutter)] py-24">
		<div class="w-full max-w-md">
			<div class="text-center">
				<a href="/" class="font-display text-2xl text-moon">Bat City Council</a>
				<p class="mt-2 font-accent text-xs uppercase tracking-[var(--tracking-eyebrow)] text-amber">
					{heading}
				</p>
				{bootstrap && (
					<p class="mt-3 text-sm text-silver/70">
						No admin exists yet. Create the first one to manage the site.
					</p>
				)}
			</div>

			<form
				method="POST"
				action={action}
				class="mt-8 space-y-4 rounded-[var(--radius-card)] border border-white/10 bg-deep/50 p-8 backdrop-blur-[var(--blur-veil)]"
			>
				{error && (
					<p class="rounded-sm border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
						{error}
					</p>
				)}

				{bootstrap && (
					<label class="block">
						<span class="font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">Name</span>
						<input
							type="text"
							name="name"
							autocomplete="name"
							class="mt-2 w-full rounded-sm border border-white/15 bg-night/60 px-4 py-3 text-moon outline-none transition focus:border-amber"
						/>
					</label>
				)}

				<label class="block">
					<span class="font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">Email</span>
					<input
						type="email"
						name="email"
						required
						autocomplete="username"
						class="mt-2 w-full rounded-sm border border-white/15 bg-night/60 px-4 py-3 text-moon outline-none transition focus:border-amber"
					/>
				</label>

				<label class="block">
					<span class="font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">Password</span>
					<input
						type="password"
						name="password"
						required
						minlength={bootstrap ? "10" : undefined}
						autocomplete={bootstrap ? "new-password" : "current-password"}
						class="mt-2 w-full rounded-sm border border-white/15 bg-night/60 px-4 py-3 text-moon outline-none transition focus:border-amber"
					/>
					{bootstrap && <span class="mt-2 block text-xs text-silver/60">At least 10 characters.</span>}
				</label>

				<button
					type="submit"
					class="w-full rounded-sm bg-amber px-8 py-4 font-accent text-sm font-semibold uppercase tracking-[var(--tracking-label)] text-night transition hover:bg-amber-light"
				>
					{bootstrap ? "Create Admin & Continue" : "Sign In"}
				</button>
			</form>

			{!bootstrap && (
				<p class="mt-6 text-center text-sm text-silver/70">
					Registered a passkey?{" "}
					<a href="/_emdash/admin" class="text-amber transition hover:text-amber-light">
						Sign in with a passkey
					</a>
				</p>
			)}
		</div>
	</section>
</Base>
