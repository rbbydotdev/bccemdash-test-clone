{
	"name": "bccemdash",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build:vendor": "pnpm run --filter {./vendor/emdash/packages/**} build",
		"dev": "pnpm --filter @myemdash/site dev",
		"dev:cf": "DEPLOY_TARGET=cloudflare pnpm --filter @myemdash/site dev",
		"build": "pnpm run build:vendor && pnpm --filter @myemdash/site build",
		"deploy": "pnpm run build:vendor && pnpm --filter @myemdash/site deploy",
		"typecheck": "pnpm run --filter {./apps/**} --filter {./packages/**} typecheck",
		"test": "pnpm run --filter {./packages/**} test"
	}
}
