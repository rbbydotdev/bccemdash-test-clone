---
/**
 * Homepage (scaffold stub). The full cinematic single-page build — hero with
 * starfield, story, mission, devotions, experiences, founder, trust, closing —
 * lands in Phase 4. This stub verifies the shell + tokens render.
 */
import Base from "../layouts/Base.astro";
---

<Base
	title="Bat City Council — Guardians of Austin's Night Sky"
	description="Bat City Council connects culture, commerce, and conservation in Austin, Texas, home of the world's largest urban bat colony."
	transparentHeader
>
	<section
		id="hero"
		class="relative flex min-h-screen items-center justify-center overflow-hidden text-center"
	>
		<div class="relative z-10 mx-auto max-w-[var(--width-prose)] px-[var(--spacing-gutter)]">
			<p class="font-accent text-sm uppercase tracking-[var(--tracking-eyebrow)] text-amber">
				Est. 2026 · Austin, Texas
			</p>
			<h1 class="mt-6 font-display text-[clamp(3.5rem,8vw+1rem,8rem)] font-light leading-[0.95] text-moon">
				Bat City<br /><span class="text-gradient-amber">Council</span>
			</h1>
			<p class="mt-6 font-display text-2xl italic text-moon/80">
				Guardians of Austin's Night Sky
			</p>
			<hr class="divider-amber" />
			<p class="mx-auto mt-6 max-w-prose text-moon/80">
				Every dusk, 1.5 million bats take flight from the heart of Austin. They are the soul of Bat
				City. And they need your devotion.
			</p>
		</div>
	</section>
</Base>
