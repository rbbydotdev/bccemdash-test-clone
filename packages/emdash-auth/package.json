{
	"name": "emdash-auth",
	"version": "0.1.0",
	"description": "Drop-in email+password sign-in, WordPress-style first-admin bootstrap, and secret-gated agent API tokens for any emdash + Astro site. Passwordless emdash stays available; this adds passwords on top.",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts",
		"./routes/login": "./src/routes/login.ts",
		"./routes/set-password": "./src/routes/set-password.ts",
		"./routes/bootstrap": "./src/routes/bootstrap.ts",
		"./routes/agent-token": "./src/routes/agent-token.ts",
		"./pages/login": "./src/pages/login.astro",
		"./pages/account-password": "./src/pages/account-password.astro"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"kysely": "catalog:",
		"ulidx": "catalog:"
	},
	"peerDependencies": {
		"astro": "catalog:",
		"emdash": "workspace:*"
	},
	"devDependencies": {
		"@types/better-sqlite3": "catalog:",
		"@types/node": "catalog:",
		"astro": "catalog:",
		"better-sqlite3": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
