---
/**
 * Homepage — the immersive single page. Eight scenes composed against anchor
 * ids the header nav smooth-scrolls to. All copy/imagery is CMS-editable
 * (BccSettings) and the tiers/experiences/partners/donors are collections.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Story from "../components/sections/Story.astro";
import Mission from "../components/sections/Mission.astro";
import Devotions from "../components/sections/Devotions.astro";
import Experiences from "../components/sections/Experiences.astro";
import Founder from "../components/sections/Founder.astro";
import Trust from "../components/sections/Trust.astro";
import Closing from "../components/sections/Closing.astro";
import Contact from "../components/sections/Contact.astro";
---

<Base
	title="Bat City Council — Guardians of Austin's Night Sky"
	description="Bat City Council connects culture, commerce, and conservation in Austin, Texas, home of the world's largest urban bat colony."
	transparentHeader
>
	<Hero />
	<Story />
	<Mission />
	<Devotions />
	<Experiences />
	<Founder />
	<Trust />
	<Closing />
	<Contact source="home" />
</Base>
