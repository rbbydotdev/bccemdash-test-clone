---
/**
 * Site footer (scaffold stub — full photo-caption footer lands in Phase 4).
 */
import { getSiteSettings } from "emdash";

const settings = (await getSiteSettings().catch(() => null)) as Record<string, unknown> | null;
const copyright =
	settings?.bcc_footer_copyright?.toString() ??
	"© 2026 Bat City Council. Austin, Texas. 501c3 nonprofit, EIN 42-2391354";
const tagline = settings?.bcc_footer_tagline?.toString() ?? "Culture · Commerce · Conservation";
---

<footer id="contact" class="border-t border-white/5 bg-deep py-[var(--spacing-section-md)]">
	<div class="mx-auto max-w-[var(--width-shell)] px-[var(--spacing-gutter)] text-center">
		<p class="font-display text-2xl text-moon">Bat City Council</p>
		<p class="mt-2 font-accent text-xs uppercase tracking-[var(--tracking-label)] text-silver">
			{tagline}
		</p>
		<p class="mt-8 text-sm text-silver/70" set:html={copyright} />
	</div>
</footer>
